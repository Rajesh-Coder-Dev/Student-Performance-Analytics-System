# ==============================================================
# STUDENT PERFORMANCE & ANALYTICS SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================
# Copy this file to .env for local development or set these variables
# directly in the Render dashboard (Environment tab).
# NEVER commit your actual .env file or real credentials to GitHub.
# ==============================================================

# 1. Django Core Security
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# 2. Database Configuration
# In Production (Supabase PostgreSQL):
# Paste the URI from Supabase: Project Settings -> Database -> Connection string (URI)
# Note: Use port 6543 (transaction pooler) with ?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# In Local Development (Fallback to MySQL if DATABASE_URL is not set):
# DB_NAME=student_performance_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# 3. Administrator Account Auto-Provisioning (Optional for first deploy on Render)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_EMAIL=admin@example.com
